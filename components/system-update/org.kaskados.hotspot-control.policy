<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>KaskadOS</vendor>
  <vendor_url>https://kaskados.xyz</vendor_url>
  <action id="org.kaskados.hotspot-control">
    <description>Manage KaskadOS network sharing</description>
    <message>Authentication is required to manage network sharing</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/kaskados/kaskados-hotspot-control</annotate>
  </action>
</policyconfig>
