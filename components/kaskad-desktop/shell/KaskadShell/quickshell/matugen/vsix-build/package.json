{
  "name": "kaskad-shell-theme",
  "displayName": "Kaskad - Kaskad Shell Theme",
  "description": "Dynamic theme using matugen & kaskad16 terminal colors - auto-updated by KaskadShell",
  "publisher": "KaskadLinux",
  "version": "0.0.3",
  "icon": "kaskadlogo.png",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "kaskad-shell",
    "kaskad",
    "material",
    "kaskadshell",
    "kaskadlinux"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lyrka-meow/KaskadOS"
  },
  "contributes": {
    "themes": [
      {
        "label": "Dynamic Base16 KaskadShell",
        "uiTheme": "vs-dark",
        "path": "./themes/kaskadshell-default.json",
        "_watch": true
      },
      {
        "label": "Dynamic Base16 KaskadShell (Dark)",
        "uiTheme": "vs-dark",
        "path": "./themes/kaskadshell-dark.json",
        "_watch": true
      },
      {
        "label": "Dynamic Base16 KaskadShell (Light)",
        "uiTheme": "vs",
        "path": "./themes/kaskadshell-light.json",
        "_watch": true
      }
    ]
  }
}
