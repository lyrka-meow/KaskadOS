source=()
sha256sums=()

package() {
  local payload=${KASKADOS_DESKTOP_PAYLOAD:?Передайте KASKADOS_DESKTOP_PAYLOAD}

  [[ -d "${payload}/opt/kaskad-desktop" ]] || return 1
  [[ -x "${payload}/usr/bin/start-kaskad-desktop" ]] || return 1
  [[ -f "${payload}/usr/share/kaskados/release.json" ]] || return 1

  install -d "${pkgdir}/opt"
  cp -a "${payload}/opt/kaskad-desktop" "${pkgdir}/opt/"

  for path in \
    usr/bin/start-kaskad-desktop \
    usr/bin/regalia \
    usr/bin/regaliad \
    usr/lib/kaskados/kaskados-system-update \
    usr/lib/kaskados/kaskados-hotspot-control \
    usr/lib/systemd/system/kaskados-hotspot-routing.service \
    usr/lib/systemd/system/kaskados-hotspot-routing.timer \
    usr/lib/NetworkManager/dispatcher.d/90-kaskados-hotspot-routing \
    usr/lib/NetworkManager/conf.d/90-kaskados-hotspot.conf \
    etc/NetworkManager/dnsmasq-shared.d/90-kaskados-hotspot-analytics.conf \
    usr/lib/regalia \
    usr/lib/systemd/system/regalia-engine@.service \
    usr/lib/systemd/user/regaliad.service \
    usr/lib/systemd/user/xdg-desktop-portal-kaskad.service \
    usr/lib/udev/rules.d/70-kaskados-input.rules \
    usr/share/applications/io.kaskados.Files.desktop \
    usr/share/applications/org.kaskados.Layout.desktop \
    usr/share/applications/org.kaskados.Shell.desktop \
    usr/share/applications/org.freedesktop.impl.portal.desktop.kaskad.desktop \
    usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.kaskad.service \
    usr/share/kaskados \
    usr/share/icons/KaskadCursorBase \
    usr/share/licenses/kaskados-desktop \
    usr/share/mime/packages/org.kaskados.layout.xml \
    usr/share/polkit-1/actions/org.kaskados.system-update.policy \
    usr/share/polkit-1/actions/org.kaskados.hotspot-control.policy \
    usr/share/polkit-1/rules.d/50-regalia-engine.rules \
    usr/share/wayland-sessions/kaskad-desktop.desktop \
    usr/share/xdg-desktop-portal/kaskaddesktop-portals.conf \
    usr/share/xdg-desktop-portal/portals/kaskad.portal; do
    [[ -e "${payload}/${path}" ]] || return 1
    install -d "${pkgdir}/$(dirname -- "${path}")"
    cp -a "${payload}/${path}" "${pkgdir}/${path}"
  done

  install -Dm0644 "${payload}/etc/xdg/mimeapps.list" \
    "${pkgdir}/etc/xdg/mimeapps.list"

  install -d "${pkgdir}/etc/systemd/user/default.target.wants"
  ln -s /usr/lib/systemd/user/regaliad.service \
    "${pkgdir}/etc/systemd/user/default.target.wants/regaliad.service"

  install -d "${pkgdir}/usr/bin"
  ln -s /opt/kaskad-desktop/shell/KaskadShell/core/bin/kaskad-shell \
    "${pkgdir}/usr/bin/kaskad-shell"
}
